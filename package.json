{
  "name": "douban-movies",
  "version": "1.0.0",
  "description": "豆瓣\"我看过的电影\"爬虫，支持增量更新",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "douban": "src/index.js"
  },
  "scripts": {
